[Unit]
Description=Atendimento Mobile - worker do agente (arq)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=atendimento
Group=atendimento
WorkingDirectory=/opt/atendimento/app/backend
Environment=UV_CACHE_DIR=/opt/atendimento/.cache/uv
ExecStart=/usr/local/bin/uv run --no-sync arq app.infra.worker.WorkerSettings
Restart=always
RestartSec=3
# uv/npm saem com 143 ao receber SIGTERM no stop: e parada normal, nao falha.
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
