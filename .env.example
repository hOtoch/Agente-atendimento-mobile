# Copie para .env (nunca commitar o .env).

# --- Postgres (dev) ---
POSTGRES_USER=atendimento
POSTGRES_PASSWORD=atendimento
POSTGRES_DB=atendimento
DATABASE_URL=postgresql+asyncpg://atendimento:atendimento@localhost:5432/atendimento

# --- Postgres de teste (tmpfs, porta 5433) ---
POSTGRES_TEST_USER=teste
POSTGRES_TEST_PASSWORD=teste
TEST_DATABASE_URL=postgresql+asyncpg://teste:teste@localhost:5433/teste

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Fila (debounce das mensagens do cliente) ---
# Segundos sem mensagem nova do cliente antes de a IA responder (padrao 10).
# FILA_JANELA_S=10
# Respostas seguidas que podem ser descartadas porque o cliente escreveu durante a geracao;
# passado o limite a resposta sai mesmo assim (padrao 2).
# FILA_MAX_DESCARTES=2

# --- LLM da conversa ---
# Provedor: anthropic (padrao, usa ANTHROPIC_API_KEY) ou openai (usa OPENAI_API_KEY, a mesma do audio).
# Com openai, troque os modelos: LLM_MODEL=gpt-4.1-mini e LLM_FALLBACK_MODEL=gpt-4o-mini.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FALLBACK_MODEL=claude-haiku-5-5
# Anthropic: effort do modelo. OpenAI: reasoning_effort, so em modelos de raciocinio (gpt-5*, o*).
LLM_EFFORT=low
# Teste de carga (infra/k6): LLM simulado, sem custo. NUNCA ligar em producao.
# LLM_FAKE_LATENCIA_MS=2750
# LLM_FAKE_JITTER_MS=1250

# --- Audio (OpenAI) ---
# Transcricao do audio do cliente (STT) e resposta em voz (TTS). Preco: ver docs/audio.md
# Sem chave: o agente pede ao cliente que digite e responde so em texto (nada quebra).
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOZ=coral

# --- Painel (frontend) ---
# Origens (separadas por virgula) liberadas no CORS da API
CORS_ORIGINS=http://localhost:3000
# URL publica do painel: base do link da conversa na mensagem ao vendedor (handoff)
PAINEL_URL=http://localhost:3000
# Base da API vista pelo navegador (lida no build do Next)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_LOJA_ID=00000000-0000-4000-8000-00000000de30

# --- Midia do chat web (upload do cliente) ---
# Pasta onde as imagens/audios enviados ficam (ignorada pelo git) e limite por arquivo (bytes)
MIDIA_DIR=./.midias
MIDIA_MAX_BYTES=10485760

# --- Evolution API (WhatsApp) ---
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-esta-chave
EVOLUTION_DB_PASSWORD=evolution
# Webhook de cada instancia (criada pela API em /lojas/{id}/whatsapp/conectar). A URL e a que o
# container da Evolution enxerga (host.docker.internal -> a API rodando no host).
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:8000/webhooks/evolution
# Segredo compartilhado do webhook (header X-Webhook-Token ou ?token=). Troque fora do dev.
EVOLUTION_WEBHOOK_TOKEN=troque-este-token
# Base publica da API (prefixo das midia_url de midias recebidas pelo WhatsApp)
API_PUBLICA_URL=http://localhost:8000
# Espera (s) antes de tratar um fromMe desconhecido como o vendedor no celular
WHATSAPP_ECO_GRACA_S=0.5

# --- Mercado Phone (ERP dos lojistas, via MCP) ---
MERCADOPHONE_MCP_URL=https://platform.mercadophone.tech/mcp/platform/
# Segredo: chave da API do Mercado Phone (opcional; sem ela a integracao fica desligada)
MERCADOPHONE_API_KEY=

# --- ERP simulado ---
ERP_MOCK_URL=http://localhost:8090
ERP_MOCK_TOKEN=token-dev
# Opcionais (comportamento do ERP simulado): latencia em ms, % de respostas 500, seed do sorteio
ERP_MOCK_LATENCIA_MS=0
ERP_MOCK_ERRO_PCT=0
# ERP_MOCK_SEED=42
